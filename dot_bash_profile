# .bash_profile: executed for login shells

# Private bin directories
if [ -d "$HOME/bin" ]; then
    PATH="$HOME/bin:$PATH"
fi
if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

# Exported environment variables
if [ -f ~/.environment_variables ]; then
    . ~/.environment_variables
fi

if [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi
